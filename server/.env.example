# Server Port
PORT=5000

# Security & JWT
JWT_SECRET=super_secret_jwt_key_english_master_2026_uzb
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/english_master_db?schema=public"

# AI Integration (OpenAI API - optional, platform has fallback intelligent engine)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# SMS Notification Provider (Twilio or Eskiz.uz for Uzbekistan +998 SMS)
SMS_PROVIDER=eskiz
SMS_API_EMAIL=user@example.com
SMS_API_PASSWORD=your_eskiz_password
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
